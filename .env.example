# URL pública do site (usada em links de retorno do pagamento, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (USD) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Pix (BRL) via Mercado Pago — Suas integrações > Credenciais de produção > Access Token
# Webhook: cadastre {NEXT_PUBLIC_SITE_URL}/api/webhooks/mercadopago (evento "Pagamentos") e copie a assinatura secreta
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mails transacionais (Resend)
RESEND_API_KEY=
EMAIL_FROM="Mind Blast <contato@seudominio.com.br>"
OWNER_EMAIL=

# Pix estático (reserva, usado só sem MERCADOPAGO_ACCESS_TOKEN): chave, nome do titular e cidade como estão no banco
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=SALTO
