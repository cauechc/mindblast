# URL pública do site (sitemap, Open Graph, schema LocalBusiness)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco de dados PostgreSQL (Supabase ou Neon). Sem ele, os leads ficam em .data/leads.json (só para testes).
DATABASE_URL=

# Painel de leads em /admin
ADMIN_PASSWORD=
# Opcional: segredo para assinar a sessão (se vazio, usa a senha)
ADMIN_SESSION_SECRET=

# Aviso por e-mail a cada lead novo (Resend). Sem a chave, o aviso só aparece no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="Casa Nova Interior <contato@seudominio.com.br>"
OWNER_EMAIL=

# Integração com CRM (opcional): cada lead novo é enviado por POST em JSON para esta URL
# (RD Station, HubSpot, Pipedrive via Make/Zapier/n8n, ou API própria)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
